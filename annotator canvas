// — SVG Connections —
function Connections({ connections, nodes, connectionTypes }) {
return (
<svg style={{ position: “absolute”, top: 0, left: 0, width: “100%”, height: “100%”, pointerEvents: “none”, zIndex: 5 }}>
<defs>
<marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
<polygon points="0 0, 10 3.5, 0 7" fill="#888" />
</marker>
{CONNECTION_TYPES.map(ct => (
<marker key={ct.id} id={`arrow-${ct.id}`} markerWidth=“10” markerHeight=“7” refX=“10” refY=“3.5” orient=“auto”>
<polygon points="0 0, 10 3.5, 0 7" fill={ct.color} />
</marker>
))}
</defs>
{connections.map((conn, i) => {
const from = nodes.find(n => n.id === conn.from);
const to = nodes.find(n => n.id === conn.to);
if (!from || !to) return null;
const ct = CONNECTION_TYPES.find(c => c.id === conn.type) || CONNECTION_TYPES[0];
const x1 = from.x + from.w + 8;
const y1 = from.y + from.h / 2;
const x2 = to.x - 8;
const y2 = to.y + to.h / 2;
const mx = (x1 + x2) / 2;
return (
<g key={i}>
<path
d={`M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`}
fill=“none”
stroke={ct.color}
strokeWidth={2}
strokeDasharray={ct.dash ? “6 4” : “none”}
markerEnd={`url(#arrow-${ct.id})`}
opacity={0.7}
/>
<text
x={mx}
y={Math.min(y1, y2) - 8}
fill={ct.color}
fontSize={9}
fontFamily=”‘IBM Plex Mono’, monospace”
textAnchor=“middle”
opacity={0.7}
>
{ct.label}
</text>
</g>
);
})}
</svg>
);
}

