// — Draggable Node on the Flowchart Canvas —
function FlowNode({ node, onDrag, onStartConnect, onEndConnect, isConnecting, selected, onSelect, onResize }) {
const [dragging, setDragging] = useState(false);
const [resizing, setResizing] = useState(false);
const dragOffset = useRef({ x: 0, y: 0 });
const colors = CATEGORY_COLORS[node.category] || CATEGORY_COLORS.concept;

const handleMouseDown = (e) => {
if (e.target.dataset.resize) return;
if (e.target.dataset.port) return;
e.stopPropagation();
setDragging(true);
dragOffset.current = { x: e.clientX - node.x, y: e.clientY - node.y };
onSelect(node.id);
};

const handleResizeDown = (e) => {
e.stopPropagation();
setResizing(true);
dragOffset.current = { x: e.clientX, y: e.clientY, w: node.w, h: node.h };
};

useEffect(() => {
if (!dragging && !resizing) return;
const handleMove = (e) => {
if (dragging) {
onDrag(node.id, e.clientX - dragOffset.current.x, e.clientY - dragOffset.current.y);
}
if (resizing) {
const dw = e.clientX - dragOffset.current.x;
const dh = e.clientY - dragOffset.current.y;
onResize(node.id, Math.max(140, dragOffset.current.w + dw), Math.max(50, dragOffset.current.h + dh));
}
};
const handleUp = () => { setDragging(false); setResizing(false); };
window.addEventListener(“mousemove”, handleMove);
window.addEventListener(“mouseup”, handleUp);
return () => { window.removeEventListener(“mousemove”, handleMove); window.removeEventListener(“mouseup”, handleUp); };
}, [dragging, resizing]);

return (
<div
onMouseDown={handleMouseDown}
style={{
position: “absolute”,
left: node.x,
top: node.y,
width: node.w,
minHeight: node.h,
background: colors.bg,
border: `2px solid ${selected ? "#fff" : colors.border}`,
borderRadius: 14,
padding: “10px 14px”,
cursor: dragging ? “grabbing” : “grab”,
boxShadow: selected ? `0 0 24px ${colors.glow}, 0 0 60px ${colors.glow}` : `0 0 12px ${colors.glow}`,
transition: dragging ? “none” : “box-shadow 0.3s”,
zIndex: dragging ? 100 : (selected ? 50 : 10),
userSelect: “none”,
}}
>
{/* Connection ports */}
<div
data-port=“out”
onMouseDown={(e) => { e.stopPropagation(); onStartConnect(node.id); }}
onMouseUp={(e) => { e.stopPropagation(); onEndConnect(node.id); }}
style={{
position: “absolute”, right: -8, top: “50%”, transform: “translateY(-50%)”,
width: 16, height: 16, borderRadius: “50%”,
background: isConnecting ? “#fff” : colors.border,
border: “2px solid #0a0a0f”,
cursor: “crosshair”,
transition: “background 0.2s”,
}}
/>
<div
data-port=“in”
onMouseUp={(e) => { e.stopPropagation(); onEndConnect(node.id); }}
style={{
position: “absolute”, left: -8, top: “50%”, transform: “translateY(-50%)”,
width: 16, height: 16, borderRadius: “50%”,
background: isConnecting ? “#fff” : colors.border,
border: “2px solid #0a0a0f”,
cursor: “crosshair”,
}}
/>
{/* Category badge */}
<div style={{
fontSize: 9, fontWeight: 700, textTransform: “uppercase”, letterSpacing: “0.12em”,
color: colors.border, marginBottom: 4, fontFamily: “‘IBM Plex Mono’, monospace”,
}}>
{node.category}
</div>
{/* Label */}
<div style={{
fontSize: 13, fontWeight: 600, color: colors.text, lineHeight: 1.3,
fontFamily: “‘IBM Plex Sans’, sans-serif”,
}}>
{node.label}
</div>
{/* Note */}
{node.note && (
<div style={{
fontSize: 11, color: “rgba(255,255,255,0.45)”, marginTop: 6, lineHeight: 1.4,
fontFamily: “‘IBM Plex Sans’, sans-serif”,
}}>
{node.note}
</div>
)}
{/* Resize handle */}
<div
data-resize=“true”
onMouseDown={handleResizeDown}
style={{
position: “absolute”, bottom: 2, right: 2, width: 14, height: 14, cursor: “nwse-resize”,
opacity: 0.3, fontSize: 10, color: colors.text, textAlign: “right”, lineHeight: “14px”,
}}
