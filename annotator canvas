export default function AnnotationCanvas() {
const [sections, setSections] = useState(MOCK_READING.sections.map((s, i) => ({ …s, order: i })));
const [flowNodes, setFlowNodes] = useState([]);
const [connections, setConnections] = useState([]);
const [mode, setMode] = useState(“select”);
const [selectedNode, setSelectedNode] = useState(null);
const [connectFrom, setConnectFrom] = useState(null);
const [connectionType, setConnectionType] = useState(“causes”);
const [showFlowchart, setShowFlowchart] = useState(false);
const [activeAnnotation, setActiveAnnotation] = useState(null);
const canvasRef = useRef(null);
const nodeCounter = useRef(0);

// Reorder sections
const handleReorder = useCallback((fromIdx, toIdx) => {
setSections(prev => {
const arr = […prev];
const [moved] = arr.splice(fromIdx, 1);
arr.splice(toIdx, 0, moved);
return arr;
});
}, []);

// Drag annotation from reading panel to canvas
const handleDragAnnotation = useCallback((ann, e) => {
setActiveAnnotation(ann.id);
e.dataTransfer.setData(“annotation”, JSON.stringify(ann));
}, []);

// Drop annotation on canvas
const handleCanvasDrop = useCallback((e) => {
e.preventDefault();
setActiveAnnotation(null);
const data = e.dataTransfer.getData(“annotation”);
if (!data) return;
const ann = JSON.parse(data);
const rect = canvasRef.current.getBoundingClientRect();
const x = e.clientX - rect.left - 80;
const y = e.clientY - rect.top - 30;
setFlowNodes(prev => […prev, {
id: `fn-${ann.id}-${Date.now()}`,
label: ann.label,
note: ann.note,
category: ann.category,
x, y, w: 200, h: 70,
}]);
}, []);

// Create new empty node
const handleAddNode = useCallback(() => {
nodeCounter.current++;
setFlowNodes(prev => […prev, {
id: `new-${Date.now()}`,
label: `New Node ${nodeCounter.current}`,
note: “Double-click to edit”,
category: “concept”,
x: 200 + Math.random() * 300,
y: 100 + Math.random() * 200,
w: 180, h: 65,
}]);
}, []);

// Drag node
const handleDragNode = useCallback((id, x, y) => {
setFlowNodes(prev => prev.map(n => n.id === id ? { …n, x, y } : n));
}, []);

// Resize node
const handleResizeNode = useCallback((id, w, h) => {
setFlowNodes(prev => prev.map(n => n.id === id ? { …n, w, h } : n));
}, []);

// Connection logic
const handleStartConnect = useCallback((id) => {
if (mode === “connect”) setConnectFrom(id);
}, [mode]);

const handleEndConnect = useCallback((id) => {
if (mode === “connect” && connectFrom && connectFrom !== id) {
setConnections(prev => […prev, { from: connectFrom, to: id, type: connectionType }]);
setConnectFrom(null);
}
}, [mode, connectFrom, connectionType]);

return (
<div style={{
width: “100%”, height: “100vh”, display: “flex”,
background: “#08080e”, color: “#e8e0d4”, overflow: “hidden”,
fontFamily: “‘IBM Plex Sans’, sans-serif”,
}}>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet" />

```
  {/* LEFT: Reading Panel */}
  <ReadingPanel
